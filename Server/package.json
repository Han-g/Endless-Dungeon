{
  "private": true,
  "name": "my-app",
  "version": "0.17.0",
  "description": "npm init template for bootstrapping an empty Colyseus project",
  "type": "module",
  "main": "build/index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "tsx watch src/index.ts",
    "loadtest": "tsx loadtest/example.ts --room waiting_room --numClients 2",
    "start:production": "node build/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "rimraf build",
    "test": "node --import tsx --no-experimental-require-module node_modules/mocha/bin/mocha.js test/*.test.ts --timeout 90000",
    "test:unit": "node --import tsx --no-experimental-require-module node_modules/mocha/bin/mocha.js test/MyRoom.test.ts --timeout 15000"
  },
  "author": "",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/colyseus/create-colyseus/issues"
  },
  "homepage": "https://github.com/colyseus/create-colyseus#readme",
  "devDependencies": {
    "@colyseus/loadtest": "^0.17.7",
    "@colyseus/sdk": "^0.17.17",
    "@colyseus/testing": "^0.17.10",
    "@types/express": "^4.17.1",
    "@types/mocha": "^10.0.1",
    "@types/node": "^22.20.5",
    "mocha": "^11.7.5",
    "mongodb-memory-server-core": "^10.4.3",
    "rimraf": "^5.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.4"
  },
  "dependencies": {
    "@colyseus/schema": "^4.0.0",
    "@colyseus/timer": "^2.0.3",
    "@colyseus/tools": "^0.17.0",
    "colyseus": "^0.17.6",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "mongodb": "^6.22.0"
  }
}
